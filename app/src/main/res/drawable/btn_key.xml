<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="@color/gp_key_shadow"/><corners android:radius="18dp"/></shape></item>
      <item android:top="0dp" android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="@color/gp_white"/><corners android:radius="18dp"/><stroke android:width="2dp" android:color="@color/gp_control_border"/></shape></item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="@color/gp_key_shadow"/><corners android:radius="18dp"/></shape></item>
      <item android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="@color/gp_white"/><corners android:radius="18dp"/><stroke android:width="2dp" android:color="@color/gp_control_border"/></shape></item>
    </layer-list>
  </item>
</selector>
