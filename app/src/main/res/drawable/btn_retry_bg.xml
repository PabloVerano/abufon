<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item android:top="8dp"><shape android:shape="rectangle"><solid android:color="@color/gp_retry_shadow"/><corners android:radius="36dp"/></shape></item>
      <item android:top="4dp" android:bottom="4dp"><shape android:shape="rectangle"><solid android:color="@color/gp_white"/><corners android:radius="36dp"/><stroke android:width="4dp" android:color="@color/gp_navy"/></shape></item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item android:top="8dp"><shape android:shape="rectangle"><solid android:color="@color/gp_retry_shadow"/><corners android:radius="36dp"/></shape></item>
      <item android:bottom="8dp"><shape android:shape="rectangle"><solid android:color="@color/gp_white"/><corners android:radius="36dp"/><stroke android:width="4dp" android:color="@color/gp_navy"/></shape></item>
    </layer-list>
  </item>
</selector>
