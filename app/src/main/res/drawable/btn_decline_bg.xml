<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item android:top="0dp" android:bottom="0dp"><shape android:shape="oval"><solid android:color="@color/gp_white"/><stroke android:width="5dp" android:color="@color/gp_red"/></shape></item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item android:bottom="0dp"><shape android:shape="oval"><solid android:color="@color/gp_white"/><stroke android:width="5dp" android:color="@color/gp_red"/></shape></item>
    </layer-list>
  </item>
</selector>
